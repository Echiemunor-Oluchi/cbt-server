# MongoDB Connection String
# Get this from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/database-name

MONGODB_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/cbt-app

# Server Port (optional, defaults to 5000)
PORT=5000

# For local MongoDB installation, use:
# MONGODB_URI=mongodb://localhost:27017/cbt-app
